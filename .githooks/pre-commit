#!/usr/bin/env bash
# ==============================================================================
# UniToDo pre-commit hook
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERIFY_SCRIPT="${REPO_ROOT}/scripts/verify.sh"

if [[ -f "${VERIFY_SCRIPT}" ]]; then
    exec "${VERIFY_SCRIPT}" --pre-commit
fi
exit 0
